# Environment Mode
NODE_ENV=development
PORT=3000

# Database URL
# For Local Development (host running postgres container on port 5433):
DATABASE_URL=postgresql://umbc_user:postgres@127.0.0.1:5433/umbc_dev

# For Production with docker-compose.prod.yml:
# DB_PASSWORD=your_strong_postgres_password
# DATABASE_URL=postgresql://umbc_user:your_strong_postgres_password@umbc-db:5432/umbc_prod

# Redis URL (optional; enables Redis Streams queue & unread count cache with automatic fallback)
REDIS_URL=redis://127.0.0.1:6379

# Umami Analytics (optional for local dev, baked into client build in production)
UMAMI_SITE_URL=https://go.rafifmsn.com/script.js
UMAMI_SITE_ID=272413f1-ac6c-4cfb-866d-8be6027b7aea
